{
  "name": "html2md",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Расширение Chrome для конвертации страниц в Markdown.",
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=extension/*.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "fflate": "^0.8.3",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10"
  }
}
