{
  "name": "html2md",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Расширение Chrome для конвертации страниц в Markdown.",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-include=extension/**/*.ts --test-coverage-include=core/**/*.ts tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "fflate": "^0.8.3",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/chrome": "^0.3.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "engines": {
    "node": ">=24.15.0 <25 || >=26.0.0 <27"
  }
}
